<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Incoming calls, the part that has to work with the app killed.
             Its own task (taskAffinity="") and out of Recents: this screen is
             a doorbell, not somewhere to come back to. showWhenLocked and
             turnScreenOn are what make it appear on a sleeping phone. -->
        <activity
            android:name=".calls.IncomingCallActivity"
            android:theme="@style/AppTheme.IncomingCall"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density" />

        <receiver
            android:name=".calls.CallActionReceiver"
            android:exported="false" />

        <!-- Firebase delivers to exactly one service. Ours extends the push
             plugin's and calls through to it, so the plugin's own declaration
             is removed rather than left to race with this one. -->
        <service
            android:name=".calls.CallPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ asks the user before any notification is shown. The app
         requests it on first sign-in; denying it only costs push, not chat. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 1:1 voice calls: the WebView needs the mic for getUserMedia.
         MODIFY_AUDIO_SETTINGS is what lets KisyCallPlugin put the call into
         MODE_IN_COMMUNICATION and choose earpiece, loudspeaker or headset
         (calls/AndroidCallAudio.java); without it the sound stays wherever
         the WebView put it, which is the loudspeaker. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Before Android 12 a Bluetooth headset is reached through an SCO link,
         which needs this install-time permission. From 12 on the headset is
         picked as a communication device and no Bluetooth permission is
         involved, so it is capped rather than turned into a runtime prompt. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- The proximity lock that blanks the screen at the ear during a voice
         call (PROXIMITY_SCREEN_OFF_WAKE_LOCK), and keeping the socket alive
         briefly while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- An incoming call has to take over a locked screen, not queue up as a
         banner. On Android 14+ the system grants this only to apps it knows to
         be calling apps; a sideloaded build falls back to a heads-up
         notification, which the app detects and reports. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The phone buzzes while it rings, including on a silent-but-not-mute profile. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Calls are pointless without a mic, but the app is still useful for
         chat on a device without one, so do not make it a hard requirement. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
